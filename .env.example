GEMINI_API_KEY=
# To bypass Netlify's build-time secrets scanner (which blocks files containing the "AIza" string):
# Option A: Paste the key WITHOUT the "AIza" prefix (e.g. SyD8rlOL3mku...) - It will be auto-prepended at runtime.
# Option B: Base64 encode the full key (e.g. btoa('AIzaSy...')) - It will be auto-decoded at runtime.
# Option C: Paste the full key (only use if not deploying on Netlify or if security scanning is bypassed).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
